    affiliation: "Renji College, Wenzhou Medical University"
license: MIT
repository-code: "https://github.com/TONYUED/prostate-cad-release"
url: "https://github.com/TONYUED/prostate-cad-release"
keywords:
  - prostate cancer
  - Gleason grading
  - semantic segmentation
  - histopathology
  - SICAPv2
